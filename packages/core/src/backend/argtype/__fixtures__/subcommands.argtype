---
exe: "vcs"
version: "1.2.0"
authors:
  - "VCS Authors"
---

/// Mini version control with subcommands
vcs: alt(
  /// Record changes to the repository
  commit: seq(
    "commit",
    opt("-m", message: str),
    opt("--amend"),
    opt("--author", author: str),
  ),
  /// Publish local commits to a remote
  push: seq(
    "push",
    opt("-u", upstream: str),
    opt("--force"),
    remote: str = "origin",
    branch: str,
  ),
)
