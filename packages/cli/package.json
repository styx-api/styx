{
  "name": "@styx-api/cli",
  "version": "0.5.3",
  "description": "Command-line interface for the Styx compiler (@styx-api/core): build typed wrappers from CLI tool descriptors and catalogs.",
  "keywords": [
    "styx",
    "niwrap",
    "boutiques",
    "code-generation",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://niwrap.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styx-api/styx-ts.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/styx-api/styx-ts/issues"
  },
  "type": "module",
  "bin": {
    "styx": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "@styx-api/core": "0.5.3",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsdown": "^0.20.1"
  }
}
