{
  "name": "greet",
  "description": "Print a greeting.",
  "tool-version": "1.0",
  "schema-version": "0.5",
  "command-line": "greet [NAME] [LOUD]",
  "inputs": [
    {
      "id": "name",
      "name": "Name",
      "description": "Person to greet.",
      "type": "String",
      "value-key": "[NAME]"
    },
    {
      "id": "loud",
      "name": "Loud",
      "description": "Shout the greeting.",
      "type": "Flag",
      "command-line-flag": "--loud",
      "value-key": "[LOUD]"
    }
  ]
}
